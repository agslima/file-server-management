# Go workspace & tooling
# =========================
# Go 1.18+ workspace
go.work
go.work.sum

# Local environment overrides
.env
.env.*
*.local

# Editor/IDE
.idea/
.vscode/
*.iml

# OS junk
.DS_Store
Thumbs.db

# =========================
# Logs
# =========================
*.log

# =========================
# Dependency caches (usually NOT in repo)
# =========================
# These are normally outside the repo, but ignore if present
/pkg/