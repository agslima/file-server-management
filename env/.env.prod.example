# Production profile (no inline secrets)
ENV_PROFILE=prod
LOG_LEVEL=info

# Core runtime
REDIS_ADDR=redis-master.file-platform.svc.cluster.local:6379
POSTGRES_DSN=postgres://fileengine:${POSTGRES_PASSWORD}@postgres-rw.file-platform.svc.cluster.local:5432/fileengine?sslmode=require
FILE_BASE_ROOT=/mnt/files
STORAGE_BACKEND=s3
S3_BUCKET=prod-file-engine-data
S3_REGION=us-east-1
S3_PREFIX=tenant-data

# OIDC/JWT verification (prod requires external identity provider)
JWT_SECRET=
JWT_PUBLIC_KEY_PEM=
JWT_JWKS_URL=https://id.example.com/realms/file-engine/protocol/openid-connect/certs
JWT_ISSUER=https://id.example.com/realms/file-engine
JWT_AUDIENCE=file-engine-prod

# Upload + governance
UPLOAD_REQUIRE_CLEAN_SCAN=true
GOVERNANCE_POLICY_SOURCE=/etc/file-engine/governance/source-envelope.json
GOVERNANCE_POLICY_SOURCE_HMAC_KEY=<set-via-secret>

# Observability
OTEL_SERVICE_NAME=file-engine
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4317

# Audit sink (example: immutable S3 WORM path)
AUDIT_IMMUTABLE_SINK_TYPE=s3_worm
AUDIT_S3_BUCKET=prod-audit-archive
AUDIT_S3_PREFIX=immutable-events
AUDIT_DEAD_LETTER_PATH=/var/lib/file-engine/audit-dlq.ndjson
