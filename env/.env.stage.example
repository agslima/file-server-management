# Stage profile (prod-like toggles, non-production secrets)
ENV_PROFILE=stage
LOG_LEVEL=info

# Core runtime
REDIS_ADDR=redis:6379
POSTGRES_DSN=postgres://fileengine:${POSTGRES_PASSWORD}@postgres:5432/fileengine?sslmode=require
FILE_BASE_ROOT=/mnt/files
STORAGE_BACKEND=local

# OIDC/JWT verification
JWT_SECRET=
JWT_PUBLIC_KEY_PEM=
JWT_JWKS_URL=https://stage-idp.example.com/realms/file-engine/protocol/openid-connect/certs
JWT_ISSUER=https://stage-idp.example.com/realms/file-engine
JWT_AUDIENCE=file-engine-stage

# Upload + governance
UPLOAD_REQUIRE_CLEAN_SCAN=true
GOVERNANCE_POLICY_SOURCE=/etc/file-engine/governance/source-envelope.json
GOVERNANCE_POLICY_SOURCE_HMAC_KEY=<set-via-secret>

# Observability
OTEL_SERVICE_NAME=file-engine-stage
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4317

# Audit sink (example: SIEM)
AUDIT_IMMUTABLE_SINK_TYPE=siem
AUDIT_SIEM_ENDPOINT=https://stage-siem.example.com/events
AUDIT_SIEM_API_KEY=<set-via-secret>
AUDIT_DEAD_LETTER_PATH=/var/lib/file-engine/audit-dlq.ndjson
