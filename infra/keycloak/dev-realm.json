{
  "realm": "file-engine",
  "enabled": true,
  "clients": [
    {
      "clientId": "file-engine-dev",
      "name": "file-engine-dev",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "defaultClientScopes": ["profile", "email", "roles"],
      "protocolMappers": [
        {
          "name": "aud-file-engine-dev",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "file-engine-dev",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {"name": "admin"},
      {"name": "viewer"},
      {"name": "iam-admin"}
    ]
  },
  "groups": [
    {"name": "engineering"},
    {"name": "finance"}
  ],
  "users": [
    {
      "username": "dev-admin",
      "enabled": true,
      "firstName": "Dev",
      "lastName": "Admin",
      "email": "dev-admin@example.com",
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "dev-admin", "temporary": false}],
      "realmRoles": ["admin", "iam-admin"],
      "groups": ["/engineering"]
    },
    {
      "username": "dev-analyst",
      "enabled": true,
      "firstName": "Dev",
      "lastName": "Analyst",
      "email": "dev-analyst@example.com",
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "dev-analyst", "temporary": false}],
      "realmRoles": ["viewer"],
      "groups": ["/finance"]
    }
  ]
}
